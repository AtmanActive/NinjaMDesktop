// NinjaMDesktop host resources.
// On Windows this is compiled by rc.exe; on Linux/macOS it is converted by swell_resgen.pl.

#include "host_resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_NJD_AUDIOCFG DIALOGEX 0, 0, 300, 146
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Audio Configuration"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    RTEXT           "Audio system:",IDC_STATIC,7,9,58,8
    COMBOBOX        IDC_NJD_BACKEND,68,7,225,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT           "Input device:",IDC_STATIC,7,27,58,8
    COMBOBOX        IDC_NJD_INDEV,68,25,225,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT           "Output device:",IDC_STATIC,7,45,58,8
    COMBOBOX        IDC_NJD_OUTDEV,68,43,225,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT           "Sample rate:",IDC_STATIC,7,63,58,8
    COMBOBOX        IDC_NJD_SRATE,68,61,80,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT           "Block size:",IDC_STATIC,152,63,50,8
    COMBOBOX        IDC_NJD_BSIZE,205,61,88,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_NJD_STATUS,7,82,286,36
    PUSHBUTTON      "Apply",IDC_NJD_APPLY,131,125,50,14
    DEFPUSHBUTTON   "OK",IDOK,187,125,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,243,125,50,14
END

#endif

#ifdef _WIN32
/////////////////////////////////////////////////////////////////////////////
//
// Icon, manifest (found via the include path: packaging/windows)
//
IDI_NJD_APPICON ICON "ninjamdesktop.ico"
1 24 "ninjamdesktop.manifest"
#endif
